{
  "name": "cosmew",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/cli",
    "apps/tui",
    "packages/agents",
    "packages/code-intel",
    "packages/contracts",
    "packages/core",
    "packages/models",
    "packages/security",
    "packages/persistence",
    "packages/sdk",
    "packages/tools",
    "packages/workspace",
    "packages/mcp"
  ],
  "scripts": {
    "cosmew": "bun --config=/dev/null --no-env-file apps/cli/src/index.ts",
    "tui": "bun --config=/dev/null --no-env-file apps/cli/src/index.ts tui",
    "test": "bun scripts/test.ts all",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters && prettier --check \"**/*.{ts,tsx,js}\" && git diff --check",
    "test:integration": "bun scripts/test.ts integration",
    "test:e2e": "bun scripts/test.ts e2e",
    "link:cli": "bun link --cwd apps/cli",
    "format": "prettier --write \"**/*.{ts,tsx,js}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js}\"",
    "build:binary": "bun scripts/build-binary.ts",
    "build:binary:all": "bun scripts/build-binary.ts --all",
    "quality": "bun run typecheck && bun run lint && bun run test",
    "test:native": "bun scripts/test.ts native",
    "test:pty": "bun scripts/test.ts pty",
    "test:live": "bun scripts/test.ts live"
  },
  "devDependencies": {
    "@cosmew/agents": "workspace:*",
    "@cosmew/code-intel": "workspace:*",
    "@cosmew/contracts": "workspace:*",
    "@cosmew/core": "workspace:*",
    "@cosmew/models": "workspace:*",
    "@cosmew/persistence": "workspace:*",
    "@cosmew/sdk": "workspace:*",
    "@cosmew/security": "workspace:*",
    "@cosmew/tools": "workspace:*",
    "@cosmew/tui": "workspace:*",
    "@cosmew/workspace": "workspace:*",
    "@types/bun": "1.4.4",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "@cosmew/mcp": "workspace:*",
    "@futryn/agents": "workspace:@cosmew/agents@*",
    "@futryn/code-intel": "workspace:@cosmew/code-intel@*",
    "@futryn/contracts": "workspace:@cosmew/contracts@*",
    "@futryn/core": "workspace:@cosmew/core@*",
    "@futryn/mcp": "workspace:@cosmew/mcp@*",
    "@futryn/models": "workspace:@cosmew/models@*",
    "@futryn/persistence": "workspace:@cosmew/persistence@*",
    "@futryn/sdk": "workspace:@cosmew/sdk@*",
    "@futryn/security": "workspace:@cosmew/security@*",
    "@futryn/tools": "workspace:@cosmew/tools@*",
    "@futryn/tui": "workspace:@cosmew/tui@*",
    "@futryn/workspace": "workspace:@cosmew/workspace@*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nguyenhuynhdt37/cosmew.git"
  }
}
