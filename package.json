{
  "name": "futryn",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/cli",
    "apps/tui",
    "packages/contracts",
    "packages/core",
    "packages/models",
    "packages/security",
    "packages/persistence",
    "packages/sdk",
    "packages/tools",
    "packages/workspace"
  ],
  "scripts": {
    "hannes": "bun apps/cli/src/index.ts",
    "futryn": "bun apps/cli/src/index.ts",
    "tui": "bun apps/cli/src/index.ts tui",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters && git diff --check",
    "test:integration": "bun test tests/contracts/provider-adapters.test.ts tests/security",
    "test:e2e": "bun test tests/end-to-end",
    "fyn": "bun apps/cli/src/index.ts",
    "link:cli": "bun link --cwd apps/cli"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/bun": "1.4.4",
    "@futryn/contracts": "workspace:*",
    "@futryn/security": "workspace:*",
    "@futryn/persistence": "workspace:*",
    "@futryn/models": "workspace:*",
    "@futryn/core": "workspace:*",
    "@futryn/sdk": "workspace:*",
    "@futryn/tui": "workspace:*",
    "@futryn/tools": "workspace:*",
    "@futryn/workspace": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nguyenhuynhdt37/futryn.git"
  }
}
