{
  "name": "futryn",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/cli",
    "apps/tui",
    "packages/agents",
    "packages/code-intel",
    "packages/contracts",
    "packages/core",
    "packages/models",
    "packages/security",
    "packages/persistence",
    "packages/sdk",
    "packages/tools",
    "packages/workspace",
    "packages/mcp"
  ],
  "scripts": {
    "hannes": "bun --config=/dev/null --no-env-file apps/cli/src/index.ts",
    "futryn": "bun --config=/dev/null --no-env-file apps/cli/src/index.ts",
    "tui": "bun --config=/dev/null --no-env-file apps/cli/src/index.ts tui",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters && prettier --check \"**/*.{ts,tsx,js}\" && git diff --check",
    "test:integration": "bun test tests/contracts/provider-adapters.test.ts tests/security",
    "test:e2e": "bun test tests/end-to-end",
    "fyn": "bun --config=/dev/null --no-env-file apps/cli/src/index.ts",
    "link:cli": "bun link --cwd apps/cli",
    "format": "prettier --write \"**/*.{ts,tsx,js}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js}\""
  },
  "devDependencies": {
    "@futryn/agents": "workspace:*",
    "@futryn/code-intel": "workspace:*",
    "@futryn/contracts": "workspace:*",
    "@futryn/core": "workspace:*",
    "@futryn/models": "workspace:*",
    "@futryn/persistence": "workspace:*",
    "@futryn/sdk": "workspace:*",
    "@futryn/security": "workspace:*",
    "@futryn/tools": "workspace:*",
    "@futryn/tui": "workspace:*",
    "@futryn/workspace": "workspace:*",
    "@types/bun": "1.4.4",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "@futryn/mcp": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nguyenhuynhdt37/futryn.git"
  }
}
